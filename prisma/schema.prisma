generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("telecalling")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryLeads Lead[]           @relation("PrimaryOwner")
  currentLeads Lead[]           @relation("CurrentOwner")
  callLogs     CallLog[]
  followUps    FollowUp[]
  siteVisits   SiteVisit[]
  assignedFrom LeadAssignment[] @relation("AssignedFrom")
  assignedTo   LeadAssignment[] @relation("AssignedTo")
  timeline     TimelineEvent[]
  bookings     Booking[]
}

model Lead {
  id             String  @id @default(cuid())
  name           String
  phone          String
  email          String?
  source         String  @default("Manual")
  budget         String?
  notes          String?
  pipelineStatus String  @default("New")
  leadStatus     String? @default("New")
  subStage       String?
  lostReason     String?

  primaryOwnerId String
  currentOwnerId String
  primaryOwner   User   @relation("PrimaryOwner", fields: [primaryOwnerId], references: [id])
  currentOwner   User   @relation("CurrentOwner", fields: [currentOwnerId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  callLogs       CallLog[]
  followUps      FollowUp[]
  siteVisits     SiteVisit[]
  assignments    LeadAssignment[]
  timeline       TimelineEvent[]
  leadProperties LeadProperty[]
  bookings       Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipelineStatus])
  @@index([source])
  @@index([currentOwnerId])
  @@index([primaryOwnerId])
  @@index([projectId])
  @@index([createdAt])
  @@index([leadStatus])
  @@index([leadStatus, subStage])
  @@index([currentOwnerId, pipelineStatus])
  @@index([updatedAt])
}

model CallLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  notes     String
  callDate  DateTime @default(now())
  callType  String   @default("Feedback")
  subStage  String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, callDate])
}

model FollowUp {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  scheduledAt DateTime
  notes       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([leadId, scheduledAt])
  @@index([userId, completed, scheduledAt])
  @@index([completed, scheduledAt])
  @@index([scheduledAt])
}

model SiteVisit {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  scheduledAt DateTime
  notes       String
  status      String   @default("Scheduled")
  feedback    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status, scheduledAt])
  @@index([leadId])
}

model LeadAssignment {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("AssignedFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("AssignedTo", fields: [toUserId], references: [id])
  reason     String?
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([toUserId])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  eventType   String
  description String
  createdAt   DateTime @default(now())

  @@index([leadId, createdAt(sort: Desc)])
}

model Project {
  id          String     @id @default(cuid())
  name        String
  location    String?
  description String?
  leads       Lead[]
  properties  Property[]
  bookings    Booking[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Property {
  id             String         @id @default(cuid())
  name           String
  type           String         @default("Apartment")
  location       String?
  price          Float?
  size           String?
  bedrooms       Int?
  bathrooms      Int?
  status         String         @default("Available")
  description    String?
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id])
  leadProperties LeadProperty[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model LeadProperty {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([leadId, propertyId])
}

model LeadSource {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String?
  source    String   @default("landing_page")
  createdAt DateTime @default(now())
}

/// Pending leads received from external portals (Housing.com, MagicBricks, etc.).
/// These are kept SEPARATE from the main Lead table so that they don't pollute the
/// main lead dashboard until an admin has reviewed and confirmed them.
/// Admin can:
///   - Assign them to a user (currentOwnerId)
///   - Assign them to a project (projectId)
///   - Pick the source / portal they came from (source)
/// When admin confirms, a real Lead row is created from this data and the PortalLead
/// row is deleted (or marked as confirmed via status field).
model PortalLead {
  id          String  @id @default(cuid())
  name        String
  phone       String
  email       String?
  source      String  @default("Manual") // Portal name: Housing.com / MagicBricks / 99acres / etc.
  budget      String?
  notes       String?
  projectName String? // Project name as it came from the portal (admin can map it later)
  portalRef   String? // External portal's lead ID/reference, for deduplication
  rawPayload  Json? // Original JSON payload received from the portal, for audit

  // Admin-assigned fields (filled in by admin before confirming):
  assignedTo String? // User ID this lead will be assigned to when confirmed
  projectId  String? // Project ID this lead will be linked to when confirmed

  status    String   @default("pending") // pending | confirmed | discarded
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([phone])
  @@index([source])
}

// One row per Housing.com partner account. Admin can connect multiple
// accounts (e.g. one per project, or one with many projects). Each account
// syncs independently and tracks its own last-sync status.
model HousingAccount {
  id                String    @id @default(cuid())
  label             String    // admin-friendly name e.g. "Royal Aura", "Multi Project Account"
  profileId         String
  encryptionKey     String
  endpointUrl       String?   // optional - the EXACT Housing API URL provided by the account manager. If empty, we try a list of common patterns.
  defaultProjectId  String?   // optional - only set when account maps to a single project
  isActive          Boolean   @default(true)
  lastSyncAt        DateTime?
  lastSyncStatus    String?   // "success" | "partial" | "error"
  lastSyncMessage   String?
  lastLeadRef       String?   // last portalRef processed, for incremental sync
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isActive])
}

model Booking {
  id String @id @default(cuid())

  // Link to lead (optional - booking can be standalone)
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // User who created the booking
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Customer details (captured at booking time)
  customerName  String
  customerPhone String
  customerEmail String?

  // Project / property info
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  propertyName String?
  unitNumber   String?

  // Booking financials
  bookingAmount Float?
  totalValue    Float?
  paymentMode   String?

  // Booking date (when the customer booked)
  bookingDate DateTime @default(now())

  // Notes / status
  notes  String?
  status String  @default("Confirmed")

  // Images stored as JSON array: [{ name, dataUrl, type, size }]
  images Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}
